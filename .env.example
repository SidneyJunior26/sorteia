# ------------------------------------------------------------------
# Database (Supabase Postgres). Use the "connection pooling" string
# from Supabase (port 6543, pgbouncer) for DATABASE_URL, and the
# direct connection (port 5432) for DIRECT_URL, used by migrations.
# ------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres"

# ------------------------------------------------------------------
# Google Books API key. OPTIONAL: the API works without a key at low
# volume (shared/anonymous quota), but a key gives you a higher,
# dedicated daily quota (~1000 req/day) and is recommended for the
# cron sync job. Get one at https://console.cloud.google.com/
# (enable "Books API", create an API key).
# ------------------------------------------------------------------
GOOGLE_BOOKS_API_KEY=""

# ------------------------------------------------------------------
# Secret used to authenticate calls to /api/cron/sync-books.
# Vercel Cron automatically sends this as
# "Authorization: Bearer <CRON_SECRET>" when this env var is set on
# the project. Generate a long random string, e.g.:
#   openssl rand -hex 32
# ------------------------------------------------------------------
CRON_SECRET="change-me-to-a-long-random-string"

# ------------------------------------------------------------------
# Affiliate placeholders — leave unset until you are approved in each
# program. The site works without them (fallback search links, no
# commission tracking yet). See README section
# "Quando for aprovado no Amazon Associados / Shopee Afiliados".
# ------------------------------------------------------------------

# Amazon Associates tracking tag, e.g. "meusite-20"
AMAZON_ASSOC_TAG=""

# Shopee Affiliate program identifiers (Open Platform)
SHOPEE_AFFILIATE_ID=""
SHOPEE_APP_ID=""
SHOPEE_APP_SECRET=""

# Mercado Livre link pattern. Must contain the literal "{query}"
# placeholder, which is replaced with the URL-encoded "title author"
# search string, e.g.:
#   MERCADOLIVRE_LINK_PATTERN="https://lista.mercadolivre.com.br/{query}?matt_word=SEUCODIGO&matt_tool=XXXXX"
MERCADOLIVRE_LINK_PATTERN=""

# ------------------------------------------------------------------
# NextAuth / Auth.js v5 — REQUIRED once the accounts feature is live.
# Without AUTH_SECRET every call to auth() throws MissingSecret, and
# since the header reads the session on every page that takes the
# whole site down, not just /estante. Generate one with:
#   openssl rand -base64 32
# ------------------------------------------------------------------
AUTH_SECRET=""

# Only needed when NOT deploying on Vercel (Vercel infers the URL).
# AUTH_URL="http://localhost:3000"
# AUTH_TRUST_HOST="true"

# ------------------------------------------------------------------
# Google OAuth — OPTIONAL. Leave both empty and the "Entrar com
# Google" button simply isn't rendered; e-mail + senha keeps working
# (same graceful-fallback pattern as the affiliate vars above).
# Create credentials at https://console.cloud.google.com/ →
# "APIs & Services" → "Credentials" → OAuth client ID (Web app).
# Authorized redirect URI: <origin>/api/auth/callback/google
#   local: http://localhost:3000/api/auth/callback/google
# ------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
