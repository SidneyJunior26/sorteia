// Prisma schema for "Sistema de Livros"
// Postgres (Supabase). See README.md for setup instructions.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Direct (non-pooled) connection, used by `prisma migrate`.
  // Falls back to DATABASE_URL if DIRECT_URL is not set.
  directUrl = env("DIRECT_URL")
}

/// Store enum for affiliate links. Whitelisted at the application
/// layer too (never trust a raw string from the URL as the store).
enum Store {
  AMAZON
  SHOPEE
  MERCADO_LIVRE
}

/// Fixed-window rate-limit counters (see lib/rate-limit.ts). Backed by
/// Postgres rather than an in-memory Map because serverless functions
/// don't share memory across invocations/regions — a Map would reset
/// on every cold start and never actually block anything across
/// concurrent requests. `windowStart` is the bucket boundary (now
/// rounded down to the window size), so a fresh row per bucket is what
/// makes the counter reset over time without an explicit expiry job.
model RateLimitEntry {
  key         String
  windowStart DateTime
  count       Int      @default(1)

  @@id([key, windowStart])
}

/// Book index, populated either by the Google Books sync cron job
/// (source="google_books") or by the one-off curated-popular-authors
/// script (source="curated", see prisma/curate.ts). `category` is
/// nullable: curated/synced books outside the 12 kept categories are
/// left uncategorized and only surface when no category filter is
/// applied.
model Book {
  id             String   @id @default(cuid())
  googleBooksId  String   @unique
  isbn           String?
  title          String
  author         String
  synopsis       String?  @db.Text
  category       String?
  language       String?
  ratingsCount   Int      @default(0)
  averageRating  Float?
  coverUrl       String?
  publishedDate  String?
  source         String   @default("google_books")
  lastSyncedAt   DateTime @default(now())
  createdAt      DateTime @default(now())

  affiliateLinks AffiliateLink[]
  // Back-relation only — the foreign key lives on ShelfItem, so this
  // adds no column to the Book table and leaves the `SELECT *` in
  // app/api/random-book/route.ts untouched.
  shelfItems     ShelfItem[]

  @@index([category])
  @@index([language])
}

/// Categories drive the Google Books search terms used by the sync
/// job, and populate the category filter dropdown on the frontend.
model Category {
  id          String @id @default(cuid())
  name        String
  slug        String @unique
  searchTerms String

  @@index([slug])
}

/// Affiliate link click counters, keyed by (bookId, store). URLs are
/// never stored here — they're built on demand in /go/[bookId]/[store]
/// from env-var driven templates, so nothing is hardcoded per book.
model AffiliateLink {
  id            String    @id @default(cuid())
  bookId        String
  store         Store
  clicks        Int       @default(0)
  lastClickedAt DateTime?
  createdAt     DateTime  @default(now())

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, store])
  @@index([bookId])
}

// ------------------------------------------------------------------
// Accounts (NextAuth / Auth.js v5 + @auth/prisma-adapter).
//
// Session strategy is JWT (forced by the Credentials provider), so the
// Session and VerificationToken tables are never written to today —
// they exist because the adapter's TypeScript contract requires
// prisma.session.* / prisma.verificationToken.* to be callable.
// ------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  /// Null for users who only ever signed in with Google.
  passwordHash String?

  /// Editable heading shown above the bookshelf. Null means "not
  /// customized" — the UI derives "Estante do {first name}" instead, so
  /// it keeps following `name` until the user overrides it explicitly.
  libraryTitle String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts   Account[]
  sessions   Session[]
  shelves    Shelf[]
  shelfItems ShelfItem[]
}

/// The snake_case column names here are not a style slip — the adapter
/// writes these exact keys. Renaming them breaks OAuth sign-in.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ------------------------------------------------------------------
// Bookshelf ("estante").
// ------------------------------------------------------------------

/// UNREAD and READ are the two shelves every user gets automatically.
/// `kind` — not the display name — is the stable identity: a user who
/// renames "Não lidos" to "Fila" must not get a duplicate recreated.
enum ShelfKind {
  UNREAD
  READ
  CUSTOM
}

model Shelf {
  id        String    @id @default(cuid())
  userId    String
  name      String
  kind      ShelfKind @default(CUSTOM)
  position  Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ShelfItem[]

  @@unique([userId, name])
  @@index([userId, position])
}

/// A book on a user's shelf.
///
/// `bookId` is nullable with onDelete: SetNull, and the title/author/
/// cover are duplicated as a snapshot on purpose. Nothing deletes Book
/// rows today (lib/sync.ts only upserts), but if a future cleanup ever
/// did, the user's shelf degrades to a spine that still renders instead
/// of silently losing books. `googleBooksId` lets a re-link job re-point
/// orphaned items at a re-synced Book.
///
/// @@unique([userId, bookId]) is what enforces "a book lives on exactly
/// one shelf" — moving it between shelves is an update of `shelfId`, not
/// a delete + insert.
model ShelfItem {
  id      String  @id @default(cuid())
  userId  String
  shelfId String
  bookId  String?

  googleBooksId String?
  title         String
  author        String
  coverUrl      String?
  isbn          String?
  category      String?

  addedAt  DateTime @default(now())
  position Int      @default(0)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  shelf Shelf @relation(fields: [shelfId], references: [id], onDelete: Cascade)
  book  Book? @relation(fields: [bookId], references: [id], onDelete: SetNull)

  @@unique([userId, bookId])
  @@index([shelfId, position])
  @@index([userId])
  @@index([googleBooksId])
}
